# DoNotStress Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit .env to Git.

# Gemini API Key (Required for live AI check-in analysis)
GEMINI_API_KEY=

# Optional comma-separated Gemini model fallback chain
# Default: gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
# GEMINI_MODEL_CHAIN=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# Stable Flask session secret key (prevents session expiration on restart)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Bind address and port (Use HOST=0.0.0.0 inside Docker)
HOST=127.0.0.1
PORT=5000

# Enable Flask debug mode only for local development (0 or 1)
FLASK_DEBUG=0

# Optional custom path for saved student records JSON (Default: data/student_records.json)
# DONOTSTRESS_DATA_PATH=data/student_records.json
