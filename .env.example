# DoNotStress Environment Configuration Template
# Copy this file to .env and configure your values.

# Stable Flask session secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your_flask_secret_key_here

# Gemini API Key (Required for AI analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Port (Default: 5000)
PORT=5000

# Optional custom path for saved student records JSON (Default: data/student_records.json)
# DONOTSTRESS_DATA_PATH=data/student_records.json
