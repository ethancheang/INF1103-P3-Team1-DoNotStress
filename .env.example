# Copy this file to .env and fill in your values.
# Never commit .env to the repository.

# Required for live AI analysis (get a key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Flask session secret. If empty, a random key is generated at startup.
FLASK_SECRET_KEY=

# Optional: override the path to the records file (default: data/student_records.json)
DONOTSTRESS_DATA_PATH=
